# Tawseela API settings. Secrets live here and never in the app. Restart the server after changes.
# Git-ignored: copy .env.example to .env on a new machine.

# --- Firebase ---------------------------------------------------------------------------------------
# Local emulators (`npm run emulators`). Keep EXPO_PUBLIC_FIREBASE_EMULATORS=1 in mobile/.env while these are on.
FIREBASE_PROJECT_ID=demo-fig
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Real Firebase project (for Replit, set these in Secrets, not in this file):
# FIREBASE_PROJECT_ID=tawssela-96447
# FIREBASE_SERVICE_ACCOUNT_JSON={...paste the NEW service-account JSON as one secret value...}
# Alternative for local-only use: GOOGLE_APPLICATION_CREDENTIALS=service-account.json (relative to server/)
# Firestore database inside the project. Use a named one (e.g. fig-fennel) when the project is shared with another app.
FIRESTORE_DATABASE_ID=

# --- Kashier Direct API (server-only secrets; set in Replit Secrets in production) ---
KASHIER_MERCHANT_ID=
KASHIER_PAYMENT_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MODE=test

# Smart POS connector secrets are encrypted at rest with AES-256-GCM.
# Generate a private 32-byte key with: openssl rand -hex 32
POS_ENCRYPTION_KEY=

# Direct API card form requires Kashier PCI DSS approval for your integration scope.
# Set to the public HTTPS backend deployment URL after publishing the API.
PUBLIC_API_URL=

# --- ImageKit ----------------------------------------------------------------------------------------
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/tawseela

# --- Demo --------------------------------------------------------------------------------------------
# Seconds between automatic stage moves for new orders, as if staff worked them (demos only). 0 = the team does it.
DEMO_KITCHEN_SECONDS=0

# --- Optional (defaults shown) -----------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
# CORS_ORIGINS=                # comma-separated browser origins; the native app sends none
# CURRENCY=EGP
# API_DOCS=true                # Swagger UI at /docs
