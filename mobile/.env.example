# Fig & Fennel app settings. Everything here is bundled into the app: public values only.
# Restart `npx expo start` after changing this file. Git-ignored: copy .env.example to .env on a new machine.

# Fig & Fennel API (server/). Leave empty on the iOS simulator and Android emulator (they reach this computer at
# 127.0.0.1:3000 and 10.0.2.2:3000). On a real phone, this computer's Wi-Fi address; for store builds, the deployed URL.
EXPO_PUBLIC_API_URL=


# 1 = sign in against the local Auth emulator. Must match server/.env (emulators on or off).
EXPO_PUBLIC_FIREBASE_EMULATORS=1
