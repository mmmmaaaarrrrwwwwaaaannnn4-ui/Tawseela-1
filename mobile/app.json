{
  "expo": {
    "name": "Tawseela",
    "slug": "tawseela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tawseela",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFDE0",
    "ios": {
      "bundleIdentifier": "com.tawseela.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIDesignRequiresCompatibility": false,
        "NSLocationWhenInUseUsageDescription": "تحتاج توصيلة إلى موقعك لتحديد عنوان التوصيل وحساب وقت الوصول بدقة.",
        "NSSpeechRecognitionUsageDescription": "تستخدم توصيلة التعرف على الكلام لتحويل ملاحظتك الصوتية إلى نص.",
        "NSMicrophoneUsageDescription": "تحتاج توصيلة إلى الميكروفون لتحويل ملاحظتك الصوتية إلى نص."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.tawseela.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDE0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 84,
          "dark": {
            "backgroundColor": "#141210",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tawseela needs access to your photos to add profile pictures and order images.",
          "cameraPermission": "تحتاج توصيلة إلى الكاميرا لإرفاق صورة بتعليمات المندوب.",
          "microphonePermission": "تحتاج توصيلة إلى الميكروفون لتسجيل تعليمات صوتية للمندوب."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "تحتاج توصيلة إلى موقعك لتحديد عنوان التوصيل وحساب وقت الوصول بدقة."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "تحتاج توصيلة إلى الميكروفون لتحويل ملاحظتك الصوتية إلى نص.",
          "speechRecognitionPermission": "تحتاج توصيلة إلى التعرف على الكلام لتحويل صوتك إلى نص داخل الملاحظة."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebase": {},
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ccb6a18a-8e35-4c12-905a-cc5ede917f99"
      }
    },
    "newArchEnabled": true
  }
}
